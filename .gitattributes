# Set default behavior for all files
* text=auto

# Force consistent line endings for key text files
*.md text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Treat shell scripts as text
*.sh text eol=lf

# Export-ignore for packaging if needed
/docs/** export-ignore
/tests/** export-ignore
